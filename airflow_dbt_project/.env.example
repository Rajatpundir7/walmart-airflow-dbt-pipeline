# Copy this file to .env and replace values for your environment.
AIRFLOW_UID=50000

# Databricks connection used by the Airflow CDC task and dbt profile.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>
DATABRICKS_JOB_ID=<your-databricks-job-id>

# dbt target settings.
DBT_CATALOG=walmart
DBT_SCHEMA=dbt_schema
DBT_THREADS=1

# Optional local PostgreSQL loader connection.
POSTGRES_RAW_CONNECTION=postgresql://<user>:<password>@<host>:5432/<database>